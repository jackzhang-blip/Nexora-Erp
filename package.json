{
  "name": "nexora-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Nexora ERP desktop application",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.4.5",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.11"
  }
}
